{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ArcheMind/sessionman-protocol/schema/unified-transcript.schema.json",
  "title": "SessionMan Unified Transcript 2.0",
  "type": "object",
  "required": ["protocolVersion", "id", "provider", "messages"],
  "additionalProperties": false,
  "properties": {
    "protocolVersion": { "const": "2.0" },
    "id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "isSubagent": { "type": "boolean", "default": false },
    "workspace": { "type": "string" },
    "title": { "type": "string" },
    "startedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "messageCount": { "type": "integer", "minimum": 0 },
    "source": { "type": "string" },
    "messages": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "runtimeEvents": { "type": "array", "items": { "$ref": "#/$defs/runtimeEvent" } }
  },
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "source", "mutability"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "source": { "enum": ["s1", "s2", "user", "world"] },
        "mutability": { "enum": ["constant", "current", "delta"] },
        "slot": { "type": "string", "minLength": 1 },
        "hash": { "type": "string", "minLength": 1 },
        "supersedesBeforeId": { "type": "string", "minLength": 1 },
        "content": { "type": "array", "items": { "$ref": "#/$defs/contentBlock" } },
        "toolResult": { "$ref": "#/$defs/toolResult" },
        "producer": { "$ref": "#/$defs/producer" },
        "stopReason": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "mutability": { "const": "delta" } } },
          "then": {
            "properties": {
              "slot": false,
              "hash": false,
              "supersedesBeforeId": false
            }
          },
          "else": {
            "required": ["slot", "content"],
            "properties": {
              "toolResult": false,
              "stopReason": false
            }
          }
        },
        {
          "if": { "properties": { "mutability": { "const": "constant" } } },
          "then": {
            "properties": {
              "supersedesBeforeId": false
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "s1" } } },
          "then": {
            "required": ["content"],
            "properties": {
              "content": {
                "type": "array",
                "items": { "$ref": "#/$defs/textBlock" }
              },
              "toolResult": false,
              "stopReason": false
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "s2" } } },
          "then": {
            "required": ["content"],
            "properties": {
              "mutability": { "const": "delta" },
              "content": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/textBlock" },
                    { "$ref": "#/$defs/thinkingBlock" },
                    { "$ref": "#/$defs/toolUseBlock" }
                  ]
                }
              },
              "toolResult": false
            }
          },
          "else": {
            "properties": {
              "stopReason": false
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "user" } } },
          "then": {
            "required": ["content"],
            "properties": {
              "content": {
                "type": "array",
                "items": {
                  "oneOf": [
                    { "$ref": "#/$defs/textBlock" },
                    { "$ref": "#/$defs/imageBlock" }
                  ]
                }
              },
              "toolResult": false
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "world" } } },
          "then": {
            "oneOf": [
              {
                "required": ["toolResult"],
                "properties": {
                  "mutability": { "const": "delta" },
                  "content": false
                }
              },
              {
                "required": ["content"],
                "properties": {
                  "toolResult": false,
                  "content": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        { "$ref": "#/$defs/textBlock" },
                        { "$ref": "#/$defs/imageBlock" }
                      ]
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "toolResult": {
      "type": "object",
      "required": ["toolUseId", "toolName"],
      "additionalProperties": false,
      "properties": {
        "toolUseId": { "type": "string", "minLength": 1 },
        "toolName": { "type": "string", "minLength": 1 },
        "result": {},
        "isError": { "type": "boolean" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "origin": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeEvent": {
      "type": "object",
      "required": ["id", "provider", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "afterMessageId": { "type": "string" },
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string" },
        "kind": {
          "enum": ["safety_refusal", "turn_aborted", "quota_exhausted", "provider_error"]
        },
        "code": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "textBlock": {
      "type": "object",
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "text" },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "thinkingBlock": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "thinking" },
        "id": { "type": "string" },
        "text": { "type": "string", "default": "" },
        "signature": { "type": "string" }
      },
      "additionalProperties": false
    },
    "toolUseBlock": {
      "type": "object",
      "required": ["type", "id", "name"],
      "properties": {
        "type": { "const": "tool_use" },
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": { "type": "object" }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "image" },
        "source": { "type": "object" }
      },
      "additionalProperties": false
    },
    "contentBlock": {
      "oneOf": [
        { "$ref": "#/$defs/textBlock" },
        { "$ref": "#/$defs/imageBlock" },
        { "$ref": "#/$defs/thinkingBlock" },
        { "$ref": "#/$defs/toolUseBlock" }
      ]
    }
  }
}
